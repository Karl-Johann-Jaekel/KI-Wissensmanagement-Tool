# Copy to .env and fill in. Never commit .env.

# --- Access ---
# Shared demo key, sent by the frontend as X-Access-Key header (min. 12 chars)
ACCESS_KEY=change-me-to-a-long-random-string

# --- LLM (mistral | ollama) ---
LLM_PROVIDER=mistral
MISTRAL_API_KEY=
# Free tier quota is per model; see docs/adr/003-llm-provider-mistral.md
MISTRAL_MODEL=ministral-14b-latest
# Used automatically when the primary model is rate-limited or down; empty disables (ADR-09)
MISTRAL_FALLBACK_MODEL=ministral-8b-latest
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b
LLM_TEMPERATURE=0.2

# --- Database ---
POSTGRES_USER=notebook
POSTGRES_PASSWORD=change-me
POSTGRES_DB=notebook

# --- Ports (host side) ---
# Production binds only the frontend to localhost; Caddy proxies to it.
FRONTEND_PORT=8080
# Dev only (docker-compose.override.yml)
BACKEND_PORT=8000

# --- Rarely changed; the defaults match the Docker image ---
# Overridden by the browser E2E to point at its mock LLM
MISTRAL_BASE_URL=https://api.mistral.ai/v1
LLM_TIMEOUT_SECONDS=90
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_CACHE_DIR=/opt/models

# --- Ingestion / retrieval tuning ---
MAX_UPLOAD_MB=20
# Uploads parsed and embedded at once. The 200-page AI Act peaked at 1.95 GiB alone; two
# such documents in parallel would exhaust the backend's memory limit.
INGEST_CONCURRENCY=1
CHUNK_MAX_CHARS=1800
CHUNK_OVERLAP_CHARS=300
RETRIEVAL_CANDIDATES=20
RETRIEVAL_TOP_K=8
