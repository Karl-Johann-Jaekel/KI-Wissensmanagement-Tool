# Copy to .env and fill in. Never commit .env.

# --- Access ---
# Shared demo key, sent by the frontend as X-Access-Key header (min. 12 chars)
ACCESS_KEY=change-me-to-a-long-random-string

# --- LLM (mistral | ollama) ---
LLM_PROVIDER=mistral
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b
LLM_TEMPERATURE=0.2

# --- Database ---
POSTGRES_USER=notebook
POSTGRES_PASSWORD=change-me
POSTGRES_DB=notebook

# --- Ports (host side) ---
# Production binds only the frontend to localhost; Caddy proxies to it.
FRONTEND_PORT=8080
# Dev only (docker-compose.override.yml)
BACKEND_PORT=8000

# --- Ingestion / retrieval tuning ---
MAX_UPLOAD_MB=20
CHUNK_MAX_CHARS=1800
CHUNK_OVERLAP_CHARS=300
RETRIEVAL_CANDIDATES=20
RETRIEVAL_TOP_K=8
